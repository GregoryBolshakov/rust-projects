{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "cargo: check",
            "type": "shell",
            "command": "cargo",
            "args": ["check", "--all-targets"],
            "problemMatcher": ["$rustc"],
            "group": "build",
            "presentation": {
                "clear": true,
                "reveal": "always",
                "panel": "shared"
            },
            "detail": "Fast type-check without producing a binary."
        },
        {
            "label": "cargo: build",
            "type": "shell",
            "command": "cargo",
            "args": ["build"],
            "problemMatcher": ["$rustc"],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "clear": true,
                "reveal": "always",
                "panel": "shared"
            },
            "detail": "Build the default binary in dev profile."
        },
        {
            "label": "cargo: build (release)",
            "type": "shell",
            "command": "cargo",
            "args": ["build", "--release"],
            "problemMatcher": ["$rustc"],
            "group": "build",
            "presentation": {
                "clear": true,
                "reveal": "always",
                "panel": "shared"
            },
            "detail": "Build with optimizations enabled."
        },
        {
            "label": "cargo: build current bin",
            "type": "shell",
            "command": "cargo",
            "args": ["build", "--bin", "${fileBasenameNoExtension}"],
            "problemMatcher": ["$rustc"],
            "group": "build",
            "presentation": {
                "clear": true,
                "reveal": "always",
                "panel": "shared"
            },
            "detail": "Build the binary that matches the active file name (use for files in src/bin/)."
        },
        {
            "label": "cargo: run",
            "type": "shell",
            "command": "cargo",
            "args": ["run"],
            "problemMatcher": ["$rustc"],
            "group": "test",
            "presentation": {
                "clear": true,
                "reveal": "always",
                "panel": "shared"
            },
            "detail": "Build and run the default binary."
        },
        {
            "label": "cargo: run current bin",
            "type": "shell",
            "command": "cargo",
            "args": ["run", "--bin", "${fileBasenameNoExtension}"],
            "problemMatcher": ["$rustc"],
            "group": "test",
            "presentation": {
                "clear": true,
                "reveal": "always",
                "panel": "shared"
            },
            "detail": "Build and run the binary matching the active file name."
        },
        {
            "label": "cargo: test",
            "type": "shell",
            "command": "cargo",
            "args": ["test"],
            "problemMatcher": ["$rustc"],
            "group": {
                "kind": "test",
                "isDefault": true
            },
            "presentation": {
                "clear": true,
                "reveal": "always",
                "panel": "shared"
            },
            "detail": "Run all unit and integration tests."
        },
        {
            "label": "cargo: clippy",
            "type": "shell",
            "command": "cargo",
            "args": ["clippy", "--all-targets", "--", "-W", "clippy::pedantic"],
            "problemMatcher": ["$rustc"],
            "group": "build",
            "presentation": {
                "clear": true,
                "reveal": "always",
                "panel": "shared"
            },
            "detail": "Run the clippy linter with pedantic warnings."
        },
        {
            "label": "cargo: fmt",
            "type": "shell",
            "command": "cargo",
            "args": ["fmt", "--all"],
            "problemMatcher": [],
            "group": "build",
            "presentation": {
                "clear": true,
                "reveal": "silent",
                "panel": "shared"
            },
            "detail": "Format every source file with rustfmt."
        },
        {
            "label": "cargo: doc",
            "type": "shell",
            "command": "cargo",
            "args": ["doc", "--no-deps", "--open"],
            "problemMatcher": [],
            "group": "build",
            "presentation": {
                "clear": true,
                "reveal": "always",
                "panel": "shared"
            },
            "detail": "Build documentation for this crate and open it in a browser."
        },
        {
            "label": "cargo: clean",
            "type": "shell",
            "command": "cargo",
            "args": ["clean"],
            "problemMatcher": [],
            "presentation": {
                "clear": true,
                "reveal": "always",
                "panel": "shared"
            },
            "detail": "Remove the target/ build directory."
        },
        {
            "label": "cargo: clean build",
            "dependsOrder": "sequence",
            "dependsOn": ["cargo: clean", "cargo: build"],
            "problemMatcher": [],
            "presentation": {
                "clear": true,
                "reveal": "always",
                "panel": "shared"
            },
            "detail": "Wipe target/ and rebuild from scratch."
        }
    ]
}
