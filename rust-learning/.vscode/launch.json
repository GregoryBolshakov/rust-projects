{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug main (gdb)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/target/debug/rust-learning",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [
                {
                    "name": "RUST_BACKTRACE",
                    "value": "1"
                }
            ],
            "externalConsole": false,
            "console": "integratedTerminal",
            "MIMode": "gdb",
            "miDebuggerPath": "/home/gregory/.cargo/bin/rust-gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                },
                {
                    "description": "Set disassembly flavor to Intel",
                    "text": "-gdb-set disassembly-flavor intel",
                    "ignoreFailures": true
                }
            ],
            "preLaunchTask": "cargo: build",
            "internalConsoleOptions": "neverOpen"
        },
        {
            "name": "Run main (no debug)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/target/debug/rust-learning",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [
                {
                    "name": "RUST_BACKTRACE",
                    "value": "1"
                }
            ],
            "externalConsole": false,
            "console": "integratedTerminal",
            "MIMode": "gdb",
            "miDebuggerPath": "/home/gregory/.cargo/bin/rust-gdb",
            "preLaunchTask": "cargo: build",
            "internalConsoleOptions": "neverOpen"
        },
        {
            "name": "Debug current bin (gdb)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/target/debug/${fileBasenameNoExtension}",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [
                {
                    "name": "RUST_BACKTRACE",
                    "value": "1"
                }
            ],
            "externalConsole": false,
            "console": "integratedTerminal",
            "MIMode": "gdb",
            "miDebuggerPath": "/home/gregory/.cargo/bin/rust-gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ],
            "preLaunchTask": "cargo: build current bin",
            "internalConsoleOptions": "neverOpen"
        },
        {
            "name": "Debug main (CodeLLDB)",
            "type": "lldb",
            "request": "launch",
            "cargo": {
                "args": ["build", "--bin=rust-learning"],
                "filter": {
                    "name": "rust-learning",
                    "kind": "bin"
                }
            },
            "args": [],
            "cwd": "${workspaceFolder}",
            "env": {
                "RUST_BACKTRACE": "1"
            },
            "sourceLanguages": ["rust"]
        },
        {
            "name": "Debug current bin (CodeLLDB)",
            "type": "lldb",
            "request": "launch",
            "cargo": {
                "args": ["build", "--bin=${fileBasenameNoExtension}"],
                "filter": {
                    "name": "${fileBasenameNoExtension}",
                    "kind": "bin"
                }
            },
            "args": [],
            "cwd": "${workspaceFolder}",
            "env": {
                "RUST_BACKTRACE": "1"
            },
            "sourceLanguages": ["rust"]
        },
        {
            "name": "Debug tests (CodeLLDB)",
            "type": "lldb",
            "request": "launch",
            "cargo": {
                "args": ["test", "--no-run", "--all-targets"],
                "filter": {
                    "kind": "bin"
                }
            },
            "args": [],
            "cwd": "${workspaceFolder}",
            "env": {
                "RUST_BACKTRACE": "1"
            },
            "sourceLanguages": ["rust"]
        }
    ]
}
